---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";

const writings = (
  await getCollection("writings", ({ data }) => !data.draft)
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<Base title="Writings">
  <h1>Writings</h1>
  {
    writings.map((entry) => (
      <div class="card">
        <h3><a href={`/writings/${entry.id}/`}>{entry.data.title}</a></h3>
        <p class="meta">
          {entry.data.date.toDateString()}
          {entry.data.readingMinutes && <> · {entry.data.readingMinutes} min read</>}
        </p>
        {entry.data.description && <p>{entry.data.description}</p>}
        {entry.data.taxonomies?.tags.map((tag) => <a class="tag" href={`/tags/${tag}/`}>#{tag}</a>)}
      </div>
    ))
  }
</Base>
