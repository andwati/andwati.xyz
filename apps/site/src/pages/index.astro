---
import { getCollection } from "astro:content";
import Base from "../layouts/Base.astro";

const writings = (await getCollection("writings", ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
---

<Base title="Home">
  <h1>Ian Andwati</h1>
  <p>Computer science, mathematics, life, and beliefs.</p>

  <h2>Latest writings</h2>
  {
    writings.length === 0 ? (
      <p class="meta">No writings published yet.</p>
    ) : (
      writings.map((entry) => (
        <div class="card">
          <h3><a href={`/writings/${entry.id}/`}>{entry.data.title}</a></h3>
          <p class="meta">{entry.data.date.toDateString()}</p>
          {entry.data.description && <p>{entry.data.description}</p>}
        </div>
      ))
    )
  }
</Base>
