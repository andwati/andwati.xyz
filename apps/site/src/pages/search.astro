---
import Base from "../layouts/Base.astro";
---

<Base title="Search">
  <h1>Search</h1>
  <p class="meta">
    Search only works against a built site (`pnpm build` runs Pagefind after
    `astro build`) — it has no index to query in `astro dev`.
  </p>
  <div id="search"></div>
  <link href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener("DOMContentLoaded", () => {
      if (window.PagefindUI) {
        // biome-ignore lint/correctness/noUndeclaredVariables: loaded from /pagefind/pagefind-ui.js above
        new PagefindUI({ element: "#search", showSubResults: true });
      }
    });
  </script>
</Base>
